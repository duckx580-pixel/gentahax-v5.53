<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.usercentrics.sdk.ui.components.UCToggle
        android:id="@+id/ucCardSectionToggleEntrySwitch"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:scaleX="0.85"
        android:scaleY="0.85"/>
    <com.usercentrics.sdk.ui.components.UCTextView
        android:textSize="@dimen/ucFontSmallSize"
        android:id="@+id/ucCardSectionToggleEntryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp">
        <com.usercentrics.sdk.ui.components.UCImageView
            android:id="@+id/ucCardSectionToggleEntryInfo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
