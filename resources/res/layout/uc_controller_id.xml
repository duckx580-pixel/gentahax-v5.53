<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.usercentrics.sdk.ui.components.UCTextView
        android:textSize="@dimen/ucFontSmallSize"
        android:id="@+id/ucControllerIdLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ucCardVerticalMargin"
        android:layout_marginHorizontal="@dimen/ucCardVerticalMargin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.usercentrics.sdk.ui.components.UCTextView
        android:textSize="@dimen/ucFontBodySize"
        android:id="@+id/ucControllerIdValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/ucCardVerticalMargin"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/ucCardHorizontalMargin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ucControllerIdCopy"
        app:layout_constraintStart_toStartOf="@+id/ucControllerIdLabel"
        app:layout_constraintTop_toBottomOf="@+id/ucControllerIdLabel"/>
    <com.usercentrics.sdk.ui.components.UCImageView
        android:id="@+id/ucControllerIdCopy"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/ucCardHorizontalMargin"
        app:layout_constraintBottom_toBottomOf="@+id/ucControllerIdValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ucControllerIdValue"
        app:layout_constraintTop_toTopOf="@+id/ucControllerIdValue"/>
</merge>
