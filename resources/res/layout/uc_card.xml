<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ucCardHeader"
        android:background="?attr/selectableItemBackground"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.usercentrics.sdk.ui.components.UCTextView
            android:textStyle="bold"
            android:id="@+id/ucCardTitle"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ucCardVerticalMargin"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="@dimen/ucCardVerticalMargin"
            app:layout_constraintEnd_toStartOf="@+id/ucCardSwitch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.usercentrics.sdk.ui.components.UCToggle
            android:id="@+id/ucCardSwitch"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:importantForAccessibility="yes"
            android:layout_marginHorizontal="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/ucCardTitle"
            app:layout_constraintEnd_toStartOf="@+id/ucCardIcon"
            app:layout_constraintStart_toEndOf="@+id/ucCardTitle"
            app:layout_constraintTop_toTopOf="@+id/ucCardTitle"/>
        <com.usercentrics.sdk.ui.components.UCButton
            android:id="@+id/ucCardIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/ucCardHorizontalMargin"
            app:layout_constraintBottom_toBottomOf="@+id/ucCardTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ucCardTitle"/>
        <com.usercentrics.sdk.ui.components.UCTextView
            android:id="@+id/ucCardDescription"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/ucCardVerticalMargin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ucCardTitle"
            app:layout_constraintTop_toBottomOf="@+id/ucCardTitle"/>
        <View
            android:id="@+id/ucCardSwitchListDivider"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ucCardVerticalMargin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ucCardDescription"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ucCardSwitchList"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ucCardVerticalMargin"
            android:layout_marginEnd="@dimen/ucCardVerticalMargin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ucCardSwitchListDivider"/>
        <View
            android:id="@+id/ucCardDividerExpandedContent"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ucCardVerticalMargin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ucCardSwitchList"/>
        <Space
            android:id="@+id/ucCardBottomSpacing"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ucCardVerticalMargin"
            app:layout_constraintTop_toBottomOf="@+id/ucCardDescription"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/ucCardExpandableContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
