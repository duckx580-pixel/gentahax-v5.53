<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.usercentrics.sdk.ui.components.UCTextView
        android:textSize="@dimen/ucFontSmallSize"
        android:id="@+id/ucCardSectionEntryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"/>
    <com.usercentrics.sdk.ui.components.UCTextView
        android:id="@+id/ucCardSectionEntryDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="viewStart"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/ucCardSectionEntryFlexbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:flexDirection="row"
        app:flexWrap="wrap"/>
</LinearLayout>
