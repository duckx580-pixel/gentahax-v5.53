<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ucHeaderBarHeight">
    <com.usercentrics.sdk.ui.components.UCImageView
        android:id="@+id/ucHeaderLogo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ucHeaderBarItemSize"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/ucHeaderBarItemHorizontalMargin"
        android:layout_marginEnd="@dimen/ucHeaderBarItemHorizontalMargin"
        app:layout_constraintBottom_toBottomOf="@+id/ucHeaderLanguagePicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ucHeaderLanguagePicker"/>
    <com.usercentrics.sdk.ui.components.UCImageView
        android:id="@+id/ucHeaderBackButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/ucHeaderBarItemPadding"
        android:visibility="gone"
        android:layout_width="@dimen/ucHeaderBarItemSize"
        android:layout_height="@dimen/ucHeaderBarItemSize"
        android:contentDescription="Back Button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ucHeaderLogo"/>
    <include
        android:id="@+id/ucHeaderLanguagePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ucHeaderBarMarginTop"
        android:layout_marginBottom="@dimen/ucHeaderBarMarginBottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ucHeaderCloseButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/ucHeaderBarItemHorizontalMargin"
        layout="@layout/uc_header_language_picker"/>
    <com.usercentrics.sdk.ui.components.UCImageView
        android:id="@+id/ucHeaderCloseButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/ucHeaderBarItemPadding"
        android:visibility="gone"
        android:layout_width="@dimen/ucHeaderBarItemSize"
        android:layout_height="@dimen/ucHeaderBarItemSize"
        android:contentDescription="Close Button"
        android:layout_marginEnd="@dimen/ucHeaderBarItemHorizontalMargin"
        app:layout_constraintBottom_toBottomOf="@+id/ucHeaderLanguagePicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ucHeaderLanguagePicker"/>
</androidx.constraintlayout.widget.ConstraintLayout>
