<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ucCookieDialogLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.usercentrics.sdk.ui.components.UCTextView
        android:textSize="@dimen/ucFontBodySize"
        android:textStyle="bold"
        android:id="@+id/ucCookieDialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ucCookieDialogClose"
        app:layout_constraintEnd_toStartOf="@+id/ucCookieDialogClose"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ucCookieLoadingBox"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ucCookieDialogTitle">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <com.usercentrics.sdk.ui.components.UCTextView
            android:textSize="@dimen/ucFontBodySize"
            android:gravity="center"
            android:id="@+id/ucCookieLoadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ucCookieRetryBox"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ucCookieDialogTitle">
        <com.usercentrics.sdk.ui.components.UCTextView
            android:textSize="@dimen/ucFontBodySize"
            android:gravity="center"
            android:id="@+id/ucCookieRetryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.usercentrics.sdk.ui.components.UCTextView
            android:textSize="@dimen/ucFontBodySize"
            android:gravity="center"
            android:id="@+id/ucCookieTryAgainBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ucCookieDialogList"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="500dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ucCookieDialogTitle"/>
    <com.usercentrics.sdk.ui.components.UCImageView
        android:id="@+id/ucCookieDialogClose"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@android:string/cancel"
        app:layout_constraintBottom_toBottomOf="@+id/ucCookieDialogTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
