<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/ucHeaderBarItemSize"
    android:layout_height="@dimen/ucHeaderBarItemSize">
    <com.usercentrics.sdk.ui.components.UCImageView
        android:id="@+id/ucHeaderLanguageIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/ucHeaderBarItemPadding"
        android:layout_width="@dimen/ucHeaderBarItemSize"
        android:layout_height="@dimen/ucHeaderBarItemSize"
        app:srcCompat="@drawable/uc_ic_language"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/ucHeaderLanguageLoading"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</FrameLayout>
